hildren:`
          @keyframes fadeIn {
            from { opacity: 0; }
            to { opacity: 1; }
          }
          @keyframes fadeToPartial {
            to { opacity: 0.5; }
          }
          @keyframes morphRectA {
            to {
              x: 315px;
              y: 35px;
              width: 50px;
              height: 75px;
              rx: 2px;
            }
          }
          @keyframes fadeOutMoveText {
            to {
              opacity: 0;
              x: 340px;
              y: 72.5px;
            }
          }
          .animate-fade-in-inner-1 {
            opacity: 0;
            animation: fadeIn 0.5s ease-out forwards 0.5s;
          }
          .animate-clone-appear {
            opacity: 0;
            /* Appear instantly at 3.5s when moving starts */
            animation: fadeIn 0.01s linear forwards 3.5s;
          }
          .animate-morph-rect {
            animation: morphRectA 1.0s ease-in-out forwards 3.5s;
          }
          .animate-fade-out-text {
            animation: fadeOutMoveText 1.0s ease-in-out forwards 3.5s;
          }
          .animate-fade-in-text-a {
            opacity: 0;
            animation: fadeIn 1.0s ease-in-out forwards 3.5s;
          }
          .animate-fade-in-inner-2 {
            opacity: 0;
            animation: fadeIn 0.5s ease-out forwards;
            animation-delay: 0.7s;
          }
          .animate-fade-in-inner-3 {
            opacity: 0;
            animation: fadeIn 0.5s ease-out forwards;
            animation-delay: 0.9s;
          }
          .animate-fade-in-manager-text {
            opacity: 0;
            animation: fadeIn 0.7s ease-out forwards;
            animation-delay: 1.5s;
          }
          .animate-fade-in-editor {
            opacity: 0;
            animation: fadeIn 1.0s ease-out forwards;
            animation-delay: 3.5s;
          }
          .animate-fade-in-editor-text {
            opacity: 0;
            animation: fadeIn 1.0s ease-out forwards;
            animation-delay: 3.5s;
          }
